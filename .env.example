# Signal Observatory environment configuration
# Copy to .env and fill in values

# Application environment: dev, demo, prod
APP_ENV=dev

# Database
DB_PATH=./signal_observatory.db
DATABASE_URL=sqlite+aiosqlite:///./signal_observatory.db

# Demo auth secret (local-only; change in production)
DEMO_AUTH_SECRET=change-me-in-production

# Keycloak OIDC (required for production)
KEYCLOAK_SERVER_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=http://localhost:3000/auth/callback

# LLM provider (optional; advisory summaries)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=15